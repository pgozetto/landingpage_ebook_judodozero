# Copie para .env.local e preencha.

# URL pública do site (usada no SEO, sitemap, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://judo.gozetto.com

# Checkout (Hotmart / Kiwify / Eduzz). Sem valor, os botões rolam até a oferta.
NEXT_PUBLIC_CHECKOUT_URL=
# Link da área de membros / download, mostrado na página /obrigado
NEXT_PUBLIC_EBOOK_ACCESS_URL=

# Rastreamento (deixe vazio para desativar)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Backend Node.js + Express (somente servidor, nunca exposto ao navegador)
# Ex.: http://localhost:4000  ->  o Next chama http://localhost:4000/v1/leads
BACKEND_API_URL=
BACKEND_API_KEY=
