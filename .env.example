# Copie para .env.local e preencha.

# URL pública do site (usada no SEO, sitemap, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://judo.gozetto.com

# Checkout (Hotmart / Kiwify / Eduzz). Sem valor, os botões rolam até a oferta.
NEXT_PUBLIC_CHECKOUT_URL=
# Link da área de membros / download, mostrado na página /obrigado
NEXT_PUBLIC_EBOOK_ACCESS_URL=

# Rastreamento (deixe vazio para desativar)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Mini guia grátis via Brevo (plano gratuito, sem automação no painel)
# Chave: Brevo > SMTP & API > API Keys. Nunca publique esta chave.
BREVO_API_KEY=
# E-mail remetente VERIFICADO no Brevo (Senders, domains & dedicated IPs > Senders)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Pedro Gozetto
# Número da lista "Mini guia" (Contatos > Listas). Opcional, mas guarda os leads.
BREVO_LIST_ID=
# Link do PDF do mini guia. Padrão: <NEXT_PUBLIC_SITE_URL>/mini-guia.pdf
MINI_GUIDE_URL=

# Envio por SMTP (ex.: Mailgun). Quando preenchido, substitui o envio pela API do Brevo.
# O Brevo continua guardando os contatos na lista (BREVO_API_KEY + BREVO_LIST_ID).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente: e-mail do seu domínio (ex.: contato@seudominio.com)
SMTP_FROM=

# Backend Node.js + Express (somente servidor, nunca exposto ao navegador)
# Ex.: http://localhost:4000  ->  o Next chama http://localhost:4000/v1/leads
BACKEND_API_URL=
BACKEND_API_KEY=
